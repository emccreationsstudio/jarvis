{
  "name": "jarvis-desktop",
  "productName": "Jarvis",
  "version": "1.0.0",
  "description": "Jarvis kişisel asistan — Windows ve Mac",
  "author": "EMC Creations Studio",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node test/commands.test.mjs",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac dir --universal --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.emccreationsstudio.jarvis.desktop",
    "productName": "Jarvis",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "renderer/**", "assets/**"],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "assets/icon.png",
      "artifactName": "Jarvis-Kurulum-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Jarvis",
      "createDesktopShortcut": true
    },
    "mac": {
      "icon": "assets/icon.png",
      "category": "public.app-category.productivity",
      "identity": null,
      "hardenedRuntime": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Jarvis'e sesli komut verebilmeniz için mikrofon kullanılır.",
        "LSUIElement": false
      }
    }
  }
}
